{
  "layout_blocks": "<html><head><style>*{box-sizing:border-box} .a{width:200px;height:50px;margin:10px;border:2px solid red;padding:5px;background:#fdd} .b{width:100px;height:40px;margin-top:20px;background:#dfd}</style></head><body><div class='a' id='a'>AAA</div><div class='b' id='b'>BB</div></body></html>",
  "layout_margin_collapse": "<html><head><style>*{box-sizing:border-box} #t{width:100px;height:30px;margin-bottom:30px;background:#fdd} #b{width:100px;height:20px;margin-top:10px;background:#dfd}</style></head><body style='margin:0'><div id='t'>T</div><div id='b'>B</div></body></html>",
  "layout_flex": "<html><head><style>*{box-sizing:border-box} #row{display:flex;width:300px;height:60px;justify-content:center;align-items:center;background:#dfd} #row>div{width:80px;height:30px;background:#fdd;margin:4px}</style></head><body style='margin:0'><div id='row'><div id='c1'>1</div><div id='c2'>2</div><div id='c3'>3</div></div></body></html>",
  "layout_grid": "<html><head><style>*{box-sizing:border-box} #g{display:grid;width:300px;height:120px;grid-template-columns:1fr 1fr 1fr;grid-template-rows:1fr 1fr;background:#fdd} #g>div{border:1px solid #999}</style></head><body style='margin:0'><div id='g'><div id='g1'>1</div><div id='g2'>2</div><div id='g3'>3</div><div id='g4'>4</div><div id='g5'>5</div><div id='g6'>6</div></div></body></html>",
  "layout_table": "<html><head><style>table{border:1px solid #000;border-collapse:collapse} td{border:1px solid #999;padding:4px}</style></head><body style='margin:0'><table id='tab'><tr><td>A</td><td>BBB</td></tr><tr><td>CC</td><td>D</td></tr></table></body></html>",
  "layout_abs": "<html><head><style>*{box-sizing:border-box} #p{position:relative;width:200px;height:100px;background:#dfd} #c{position:absolute;left:30px;top:20px;width:50px;height:40px;background:#fdd}</style></head><body style='margin:0'><div id='p'><div id='c'>C</div></div></body></html>",
  "layout_text_wrap": "<html><head><style>body{margin:0} #w{width:150px;height:120px;font-size:16px;overflow:hidden;background:#fdd}</style></head><body><div id='w'>The quick brown fox jumps over the lazy dog, and keeps on jumping repeatedly until it is very tired indeed.</div></body></html>",
  "flex_reverse": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;flex-direction:row-reverse;}#row>div{width:40px;height:20px;margin:4px;background:#f00;}</style></head><body><div id=\"row\"><div id=\"c1\"></div><div id=\"c2\"></div><div id=\"c3\"></div></div></body></html>",
  "flex_reverse_center": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;flex-direction:row-reverse;justify-content:center;}#row>div{width:40px;height:20px;margin:4px;background:#f00;}</style></head><body><div id=\"row\"><div id=\"c1\"></div><div id=\"c2\"></div><div id=\"c3\"></div></div></body></html>",
  "flex_reverse_end": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;flex-direction:row-reverse;justify-content:flex-end;}#row>div{width:40px;height:20px;margin:4px;background:#f00;}</style></head><body><div id=\"row\"><div id=\"c1\"></div><div id=\"c2\"></div><div id=\"c3\"></div></div></body></html>",
  "flex_gap": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;gap:10px;}#row>div{width:40px;height:20px;margin:4px;background:#f00;}</style></head><body><div id=\"row\"><div id=\"c1\"></div><div id=\"c2\"></div><div id=\"c3\"></div></div></body></html>",
  "flex_single_around": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;justify-content:space-around;}#row>div{width:40px;height:20px;margin:4px;background:#f00;}</style></head><body><div id=\"row\"><div id=\"c1\"></div></div></body></html>",
  "flex_single_evenly": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;justify-content:space-evenly;}#row>div{width:40px;height:20px;margin:4px;background:#f00;}</style></head><body><div id=\"row\"><div id=\"c1\"></div></div></body></html>",
  "flex_padding_border": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;justify-content:center;}#row>div{width:40px;height:20px;margin:4px;background:#f00;padding:5px;border:2px solid blue;}</style></head><body><div id=\"row\"><div id=\"c1\"></div><div id=\"c2\"></div><div id=\"c3\"></div></div></body></html>",
  "flex_column": "<!DOCTYPE html><html><head><style>body{margin:0}#row{display:flex;width:300px;height:150px;flex-direction:column;justify-content:center;}#row>div{width:40px;height:20px;margin:4px;background:#f00;}</style></head><body><div id=\"row\"><div id=\"c1\"></div><div id=\"c2\"></div><div id=\"c3\"></div></div></body></html>",
  "grid_unequal": "<!DOCTYPE html><html><head><style>body{margin:0}#g{display:grid;width:300px;grid-template-columns:1fr 2fr;gap:10px}#g>div{height:20px;background:red}</style></head><body><div id=\"g\"><div id=\"g1\"></div><div id=\"g2\"></div></div></body></html>",
  "percent_height": "<!DOCTYPE html><html><body style=\"margin:0\"><div id=\"p\" style=\"height:200px;width:200px\"><div id=\"c\" style=\"height:50%;width:50%;background:red\"></div></div></body></html>"
