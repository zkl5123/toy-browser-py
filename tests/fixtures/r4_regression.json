{
  "_comment": "R4 stage 6 — offline regression fixtures frozen from the 20261016 assessment (assessments/20261016/). Each case pins a browser-facing contract against its Edge/Chromium reference value. The js_cases / edge_js_expect / layout_cases / edge_layout_expect blocks are copied verbatim from the assessment's edge_*.json reference files; the e2e_cases block freezes the 10 network/CSP e2e pages (document + CSP directives + in-memory subresource/script/fetch responses) so they replay without a socket. Tolerances: painted red-boundary within 1px on every side (the 1px raster ring vs CSS 2px border); layout border-box within 0.1px.",

  "js_dom_html": "<!DOCTYPE html><html><body><div id=\"t1\">orig</div><button id=\"btn\">B</button></body></html>",

  "js_cases": [
    {"id": "js_basic_arith", "code": "console.log(2 + 3 * 4, 10 / 4, 10 % 3, -5 + 2)"},
    {"id": "js_precedence", "code": "console.log(2 * 3 + 4, (2 + 3) * 4, 2 ** 3, 100 - 20 * 3)"},
    {"id": "js_ternary", "code": "var a = 5; console.log(a > 3 ? 'yes' : 'no'); console.log(1 > 2 ? 10 : 20)"},
    {"id": "js_typeof", "code": "console.log(typeof 42, typeof 's', typeof null, typeof undefined, typeof {}, typeof [])"},
    {"id": "js_string_concat", "code": "console.log('x:' + 1 + true, 1 + '1', 'a' + 'b' + 2)"},
    {"id": "js_str_escapes", "code": "console.log('a\\nb'); console.log('say \\\"hi\\\"'); console.log('tab\\tend')"},
    {"id": "js_arrays", "code": "var arr = [1,2,3,4,5]; console.log(arr.length, arr[2], arr.at(-1), arr.at(99)); console.log(arr.indexOf(3), arr.includes(9), arr.slice(1,3)); console.log(arr.map(function(v,i){return v*2}), arr.join('-'))"},
    {"id": "js_arrow_funcs", "code": "var f = (a,b) => a + b; console.log(f(1,2), [1,2,3].map(x => x*x).join(','), [1,2,3].filter(x => x > 1).join(','))"},
    {"id": "js_object_methods", "code": "var o = {a:1,b:2,c:3}; console.log(Object.keys(o).join(','), Object.values(o).join(',')); console.log(JSON.stringify({x:1, arr:[1,2]})); var p = JSON.parse('{\"q\":[1,{r:true}]}'); console.log(p.q[1].r)"},
    {"id": "js_classes", "code": "class Animal { constructor(n) { this.name = n } speak() { return this.name + ' makes a sound' } } class Dog extends Animal { constructor(n) { super(n) } speak() { return this.name + ' barks' } } var d = new Dog('Rex'); console.log(d.speak()); var a = new Animal('Cow'); console.log(a.speak())"},
    {"id": "js_templates", "code": "var x = 5; var s = `x is ${x * 2} and ${true}`; console.log(s); console.log(`total=${1+2}`)"},
    {"id": "js_optional_nullish", "code": "var o = {a: {b: 1}}; console.log(o?.a?.b, o?.z?.b, null ?? 'dflt', 0 ?? 'dflt', '' ?? 'dflt')"},
    {"id": "js_try_catch", "code": "try { var y = 1 / 0; console.log(y) } catch(e) { console.log('caught', e.message) } finally { console.log('done') }"},
    {"id": "js_errors", "code": "console.log(NaN === NaN, 1 / 0, 0 / 0, String.fromCharCode(65), 'ABC'.charCodeAt(0))"},
    {"id": "js_numbers", "code": "console.log(Number.isInteger(3.0), Number.isInteger(3.5), Number.parseInt('42px'), Number.parseFloat('3.14abc'), Math.round(2.5), Math.floor(2.9), Math.max(1,9,3))"},
    {"id": "js_promise", "code": "var p = Promise.resolve(41).then(function(v){ return v + 1 }).then(function(v){ console.log('prom:', v) });"},
    {"id": "js_destructuring", "code": "var p = {x: 10, y: 20}; var {x, y} = p; console.log(x + y, x - y); var pair = [1, 2, 3]; var [a, b] = pair; console.log(a, b, pair[2])"},
    {"id": "js_spread", "code": "var o1 = {a: 1}; var o2 = {...o1, b: 2}; console.log(o2.a, o2.b); var arr = [...[1,2], ...[3,4], 5]; console.log(arr.join(','))"},
    {"id": "js_for_loops", "code": "var s = ''; for (var i = 0; i < 5; i++) { s += i } console.log(s); var t = 0; for (var v of [1,2,3,4]) { t += v } console.log(t)"},
    {"id": "js_dom_bind", "code": "var el = document.getElementById('t1'); el.innerHTML = 'clicked!'; console.log(el.tagName, document.body.innerText)"},
    {"id": "js_event_click", "code": "var c = 0; document.getElementById('btn').onclick = function() { c++; this.style.display = 'none'; console.log('clicks:', c) }; document.getElementById('btn').click(); document.getElementById('btn').click(); console.log('final:', c)"},
    {"id": "js_set_timeout", "code": "var log2 = []; setTimeout(function(){ log2.push('b') }, 10); setTimeout(function(){ log2.push('a') }, 5); log2.push('sync'); console.log('before:', log2.join(','));"},
    {"id": "js_while_break", "code": "var n = 0; outer: while (n < 100) { n++; if (n % 7 === 0 && n > 10) { console.log('break at', n); break } } console.log('n =', n)"},
    {"id": "js_generators", "code": "function* gen() { yield 1; yield 2; yield 3; } var g = gen(); console.log(g.next().value, g.next().value, g.next().done)"},
    {"id": "js_regexp", "code": "var re = /a(b+)c/dg; var m = re.exec('abcbbc'); console.log(m[0], m[1], m.index); console.log('X1X2X3'.split('X').join('-')); console.log('abc'.replace('b', 'B'), 'a-b-c'.replaceAll('-', '+'))"},
    {"id": "js_date", "code": "var d = new Date(2024, 1, 15, 10, 30, 0); console.log(d.getFullYear(), d.getMonth(), d.getDate(), d.getHours())"},
    {"id": "js_infinity_nan", "code": "console.log(Infinity > 1e100, 1/0, 0/0, NaN == NaN, Number.isNaN(NaN))"},
    {"id": "js_functions_args", "code": "function f(a, b, c) { return [a, b, c] } console.log(f(1).join(','), f(1,2,3,4).join(',')); function g() { return [g.length, arguments.length] } console.log(g(1,2,3).join('/'))"},
    {"id": "js_string_methods", "code": "console.log('  hi  '.trim(), 'abc'.repeat(3), 'hello'.padStart(9, '.'), 'Hello'.toUpperCase().toLowerCase().length, 'a,b,c'.split(',').map(x => x.trim()).join('|'))"},
    {"id": "probe_const_write", "code": "try{const a=1;a=2;console.log('changed',a)}catch(e){console.log('caught')}"},
    {"id": "probe_tdz", "code": "try{console.log(x);let x=1}catch(e){console.log('caught')}"},
    {"id": "probe_reference_error", "code": "try{console.log(noSuchBinding)}catch(e){console.log('caught')}"},
    {"id": "probe_array_json", "code": "console.log(JSON.stringify([1,2,3].map(function(v){return v*2})) );"},
    {"id": "probe_object_identity", "code": "var a={};var b={};console.log(a===a,a===b);"},
    {"id": "probe_remove_dom", "code": "var el=document.getElementById('t1');el.parentNode.removeChild(el);console.log(document.getElementById('t1')===null);"},
    {"id": "probe_unsupported_css", "code": "console.log(typeof CSS,typeof CSS.supports);"},
    {"id": "probe_string_timer", "code": "setTimeout(\"console.log('timer')\",0);console.log('sync');"},
    {"id": "functional_queue_microtask", "code": "console.log('sync');queueMicrotask(function(){console.log('micro')});console.log('end');"},
    {"id": "functional_mutation_observer", "code": "var observer=new MutationObserver(function(){console.log('mutated')});observer.observe(document.getElementById('t1'),{childList:true});document.getElementById('t1').textContent='changed';Promise.resolve().then(function(){console.log('checkpoint')});"},
    {"id": "functional_resize_observer", "code": "var observer=new ResizeObserver(function(){console.log('resized')});observer.observe(document.getElementById('t1'));"},
    {"id": "functional_response_methods", "code": "fetch('http://127.0.0.1:1/').then(function(r){console.log(typeof r.text,typeof r.json)});"},
    {"id": "probe_microtasks", "code": "console.log('start'); Promise.resolve().then(function(){console.log('promise')}); console.log('end');"},
    {"id": "probe_timer_order", "code": "setTimeout(function(){console.log('late')},30);setTimeout(function(){console.log('early')},0);console.log('sync');"},
    {"id": "probe_event_bubble", "code": "document.body.addEventListener('click',function(){console.log('body')});document.getElementById('btn').addEventListener('click',function(){console.log('button')});document.getElementById('btn').click();"},
    {"id": "probe_dom_live", "code": "var el=document.getElementById('t1');el.innerHTML='<span id=child>new</span>';console.log(document.getElementById('child').textContent);"},
    {"id": "probe_json_numbers", "code": "console.log(JSON.stringify([NaN,Infinity,undefined,-0]));"},
    {"id": "probe_equality", "code": "console.log(JSON.stringify([[]==false,[]==0,null==undefined,'0'==false,{}=== {}]));"},
    {"id": "probe_api_types", "code": "console.log(typeof fetch,typeof XMLHttpRequest,typeof MutationObserver,typeof queueMicrotask,typeof ResizeObserver);"},
    {"id": "probe_fetch_contract", "code": "console.log(typeof fetch('http://127.0.0.1:1/').then);"},
    {"id": "probe_async", "code": "async function f(){return 42} f().then(function(v){console.log(v)});"},
    {"id": "probe_dom_create", "code": "var el=document.createElement('div');el.id='added';el.textContent='hello';document.body.appendChild(el);console.log(document.getElementById('added').textContent);"}
  ],

