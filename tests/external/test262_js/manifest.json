      "status": "pass",
      "execute": "var s=0; for(var v of [1,2,3,4]){s+=v}",
      "readback": "s"
    },
    {
      "id": "es-for-of-string",
      "spec": "ECMA-262 §15.1",
      "title": "for...of 字符串",
      "expected": "ab",
      "reason": "逐字符",
      "status": "pass",
      "execute": "var r=''; for(var c of 'ab'){r+=c}",
